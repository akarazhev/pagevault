{
  "name": "pagevault-local-archive",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Browser extension and persistent Go SQLite archive.",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:core": "node --test tests/core.test.cjs",
    "test:host": "go test ./...",
    "test:browser": "node --test --test-concurrency=1 tests/extractor.test.cjs tests/integration.test.cjs",
    "check": "node scripts/check.mjs",
    "package": "go run ./cmd/release",
    "package:extension": "go run ./cmd/release --extension-only",
    "package:macos": "go run ./cmd/package-macos",
    "build": "go build -trimpath -buildvcs=false -o bin/pagevault-host ./cmd/pagevault",
    "lint": "eslint .",
    "format": "prettier --write \"{extension,scripts,tests}/**/*.{js,cjs,mjs,json,css,html}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"{extension,scripts,tests}/**/*.{js,cjs,mjs,json,css,html}\" \"*.{json,js}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=26.12.1",
    "npm": ">=12.2.1"
  }
}
